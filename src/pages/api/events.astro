---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import TypeLink from '../../components/api/TypeLink.astro';
import { api, withBase } from '../../lib/api';
import '../../components/api/api.css';
---
<StarlightPage frontmatter={{ title: 'Events', description: 'LuaHUD event callbacks, when they run, and their payload types.', editUrl: false }}>
  <p>Register a listener with <code>lh.on("event-name", callback)</code>. Events with a payload pass it as the callback’s first argument. Register listeners once when your profile loads.</p>
  <p>See <a href={withBase('/guides/events-and-timers/')}>Events and Timers</a> for callback lifetimes and scheduling.</p>
  <div class="reference-table" tabindex="0" role="region" aria-label="Events">
    <table>
      <thead><tr><th>Event</th><th>Description</th><th>Payload</th></tr></thead>
      <tbody>{api.events.map(event => <tr id={`event-${event.name}`}>
        <td><code>{event.name}</code></td>
        <td>{event.description}</td>
        <td>{event.payloadType.kind === 'primitive' && event.payloadType.name === 'nil' ? 'None (callback receives no payload).' : <TypeLink type={event.payloadType} />}</td>
      </tr>)}</tbody>
    </table>
  </div>
</StarlightPage>
