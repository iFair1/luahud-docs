---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ApiTree from "../../components/api/ApiTree.astro";
import { api, anchorId } from "../../lib/api";

const headings = api.root.children.map((node) => ({
    depth: 2,
    slug: anchorId(node.path),
    text: node.kind === "function" ? `${node.name}()` : node.name,
}));
---

<StarlightPage
    frontmatter={{
        title: "API reference",
        description: "Explore the LuaHUD API for custom Minecraft HUDs. Browse namespaces, properties, functions, parameter types, and model references for your Lua profiles.",
        editUrl: false,
    }}
    headings={headings}
>
    <p>
        Explore the <code>lh</code> API. Open a namespace or function to see its
        members and parameter rows. Named types identify the models and options
        accepted by each member.
    </p>
    <p>
        <small>
            A <code>?</code> after a type or parameter means it can be{" "}
            <code>nil</code>.
        </small>
        <small>
            LuaHUD currently uses Lua 5.2, so <code>integer</code> and{" "}
            <code>number</code> are the same type.
        </small>
    </p>
    <ApiTree root={api.root} />
</StarlightPage>

<style is:global>
    :root {
        --sl-content-width: 80rem;
    }
</style>
