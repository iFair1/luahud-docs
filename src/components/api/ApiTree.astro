---
import type { NamespaceNode } from '../../lib/api';
import ApiNode from './ApiNode.astro';
interface Props { root: NamespaceNode }
const { root } = Astro.props;
---
<api-explorer class="api-explorer not-content">
  <div class="api-toolbar" hidden>
    <label class="api-search"><span class="sr-only">Filter API members</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4.5 4.5" /></svg><input type="search" placeholder="Filter by name, description, or type…" aria-label="Filter API members" /></label>
    <div class="api-actions"><button type="button" data-expand>Expand all</button><button type="button" data-collapse>Collapse all</button></div>
  </div>
  <p class="api-filter-status" role="status" aria-live="polite" hidden></p>
  <div class="api-grid-scroll" role="region" aria-label="API reference tree" tabindex="0">
    <div class="api-grid">
      <div class="api-columns" aria-hidden="true"><span>Member / parameters</span><span>Description</span><span>Type / returns</span></div>
      <ul class="api-tree"><ApiNode node={root} root /></ul>
    </div>
  </div>
  <p class="api-empty" hidden>No matching API members. Try another name or type.</p>
</api-explorer>

<script>
  class ApiExplorer extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const input = this.querySelector<HTMLInputElement>('input')!;
      const nodes = [...this.querySelectorAll<HTMLElement>('[data-api-node]')];
      const details = [...this.querySelectorAll<HTMLDetailsElement>('details')];
      const status = this.querySelector<HTMLElement>('.api-filter-status')!;
      const empty = this.querySelector<HTMLElement>('.api-empty')!;
      const toolbar = this.querySelector<HTMLElement>('.api-toolbar')!;
      let savedState: boolean[] | undefined;
      toolbar.hidden = false;

      const filter = () => {
        const terms = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
        if (terms.length && !savedState) savedState = details.map(detail => detail.open);
        const matchingNamespaces = nodes.filter(node => node.dataset.kind === 'namespace'
          && terms.every(term => node.dataset.search!.includes(term)));
        // Descendants are resolved before their parents, at any nesting depth.
        for (const node of [...nodes].reverse()) {
          const matches = terms.every(term => node.dataset.search!.includes(term))
            || matchingNamespaces.some(namespace => namespace.contains(node));
          const children = [...node.querySelectorAll<HTMLElement>(':scope > details > ul > [data-api-node]')];
          node.hidden = terms.length > 0 && !matches && !children.some(child => !child.hidden);
        }
        if (terms.length) {
          details.forEach(detail => { if (!detail.closest<HTMLElement>('[data-api-node]')!.hidden) detail.open = true; });
        } else if (savedState) {
          details.forEach((detail, i) => { detail.open = savedState![i]; });
          savedState = undefined;
        }
        const count = nodes.filter(node => node.dataset.kind !== 'namespace' && !node.hidden).length;
        status.hidden = terms.length === 0;
        status.textContent = `${count} matching ${count === 1 ? 'member' : 'members'}`;
        empty.hidden = terms.length === 0 || count > 0;
      };

      const revealHash = () => {
        let id: string;
        try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
        const target = document.getElementById(id);
        if (!target || !this.contains(target)) return;
        if (input.value) { input.value = ''; filter(); }
        if (target instanceof HTMLDetailsElement) target.open = true;
        let parent = target.parentElement;
        while (parent && parent !== this) {
          if (parent instanceof HTMLDetailsElement) parent.open = true;
          parent = parent.parentElement;
        }
        requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
      };

      input.addEventListener('input', filter);
      this.querySelector('[data-expand]')!.addEventListener('click', () => details.forEach(detail => { detail.open = true; }));
      this.querySelector('[data-collapse]')!.addEventListener('click', () => details.forEach(detail => { detail.open = false; }));
      window.addEventListener('hashchange', revealHash, { signal: this.abort.signal });
      revealHash();
    }
    private abort = new AbortController();
    disconnectedCallback() { this.abort.abort(); }
  }
  if (!customElements.get('api-explorer')) customElements.define('api-explorer', ApiExplorer);
</script>

<style is:global>
  .api-explorer {
    display: block;
    margin-top: 1.5rem;
    --api-border: var(--sl-color-gray-5);
    --api-columns: minmax(22rem, 1.35fr) minmax(18rem, 2fr) minmax(10rem, .7fr);
    --api-hover: color-mix(in srgb, var(--sl-color-gray-5) 30%, var(--sl-color-bg));
  }
  .api-explorer [hidden] { display: none !important; }
  .api-explorer .api-toolbar { display: flex; flex-wrap: wrap; gap: .75rem; margin-bottom: 1rem; }
  .api-explorer .api-search { display: flex; align-items: center; flex: 1 1 18rem; gap: .6rem; border: 1px solid var(--api-border); border-radius: .4rem; padding: .6rem .8rem; color: var(--sl-color-gray-2); background: var(--sl-color-bg); }
  .api-explorer .api-search:focus-within { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
  .api-explorer input { width: 100%; min-width: 0; border: 0; outline: 0; font: inherit; font-size: .875rem; color: var(--sl-color-text); background: transparent; }
  .api-explorer input::placeholder { color: var(--sl-color-gray-3); }
  .api-explorer .api-actions { display: flex; gap: .5rem; }
  .api-explorer button { border: 1px solid var(--api-border); border-radius: .4rem; padding: .6rem .8rem; background: var(--sl-color-bg); color: var(--sl-color-text); font: inherit; font-size: .8rem; cursor: pointer; }
  .api-explorer button:hover { border-color: var(--sl-color-accent); color: var(--sl-color-text-accent); }
  .api-explorer :is(button, a, summary, .api-grid-scroll):focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: -2px; }
  .api-explorer :is(ul, li, p) { margin: 0; padding: 0; }
  .api-explorer ul { list-style: none; }
  .api-explorer .api-grid-scroll { overflow-x: auto; border: 1px solid var(--api-border); border-radius: .5rem; }
  .api-explorer .api-grid { min-width: 50rem; }
  .api-explorer :is(.api-columns, .api-row) { display: grid; grid-template-columns: var(--api-columns); align-items: stretch; }
  .api-explorer .api-columns { background: var(--api-hover); color: var(--sl-color-gray-2); font-size: .75rem; font-weight: 600; letter-spacing: .025em; }
  .api-explorer .api-columns > span { padding: .7rem .9rem; }
  .api-explorer .api-columns > span + span { border-inline-start: 1px solid var(--api-border); }
  .api-explorer .api-row { border-top: 1px solid var(--api-border); font-size: .82rem; line-height: 1.6; }
  .api-explorer .api-row > span { display: flex; align-items: center; min-width: 0; padding: .7rem .9rem; }
  .api-explorer .api-row > span + span { border-inline-start: 1px solid var(--api-border); }
  .api-explorer .api-row > .api-member { padding-inline-start: calc(.9rem + var(--api-depth, 0) * 1.1rem); gap: .6rem; white-space: nowrap; }
  .api-explorer .api-row:hover { background: var(--api-hover); }
  .api-explorer summary { cursor: pointer; list-style: none; }
  .api-explorer summary::-webkit-details-marker { display: none; }
  .api-explorer .api-namespace > summary { background: color-mix(in srgb, var(--sl-color-gray-5) 15%, var(--sl-color-bg)); }
  .api-explorer .api-namespace > summary:hover { background: var(--api-hover); }
  .api-explorer :is(.api-chevron, .api-branch) { display: inline-block; width: .6rem; flex: 0 0 .6rem; color: var(--sl-color-gray-3); font: 1rem/1 var(--sl-font-mono); }
  .api-explorer .api-branch { font-size: .85rem; opacity: .65; }
  .api-explorer details[open] > summary > .api-member > .api-chevron { transform: rotate(90deg); }
  .api-explorer .api-name { color: var(--sl-color-white); font-family: var(--sl-font-mono); font-weight: 600; font-size: .85rem; }
  .api-explorer .api-punctuation { color: var(--sl-color-gray-3); }
  .api-explorer .api-row > .api-description { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--sl-color-gray-2); }
  .api-explorer .api-kind { color: var(--sl-color-gray-3); font-size: .75rem; white-space: nowrap; }
  .api-explorer .api-type { font-family: var(--sl-font-mono); font-size: .8rem; color: var(--sl-color-gray-2); white-space: nowrap; }
  .api-explorer .api-type a { color: var(--sl-color-text-accent); text-decoration: underline; text-underline-offset: .2em; }
  .api-explorer .api-member-link { text-decoration: none; }
  .api-explorer .api-member-link:hover { text-decoration: underline; text-underline-offset: .2em; }
  .api-explorer .api-signature { font-family: var(--sl-font-mono); font-size: .8rem; color: var(--sl-color-text); white-space: nowrap; }
  .api-explorer .api-parameter .api-name { font-weight: 400; color: var(--sl-color-gray-2); }
  .api-explorer .api-filter-status, .api-explorer .api-empty { font-size: .85rem; color: var(--sl-color-gray-2); margin-block: .75rem; }
  .api-explorer [id] { scroll-margin-top: 6rem; }
  .api-explorer :target:is(.api-property, details > summary) { background: var(--api-hover); }
  .api-explorer details:target > summary { box-shadow: inset 3px 0 var(--sl-color-accent); }
  .api-explorer .api-property:target { box-shadow: inset 3px 0 var(--sl-color-accent); }
</style>
